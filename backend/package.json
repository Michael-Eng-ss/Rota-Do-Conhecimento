{
  "name": "rota-do-conhecimento-backend",
  "version": "1.0.0",
  "description": "Backend Express + TypeORM para o Rota do Conhecimento",
  "main": "build/src/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node build/src/index.js",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "db:seed": "ts-node -r tsconfig-paths/register scripts/seed-questoes.ts",
    "test:unit": "jest --config=jest.unit.config.js",
    "test:unit:watch": "jest --config=jest.unit.config.js --watch",
    "test:unit:coverage": "jest --config=jest.unit.config.js --coverage",
    "test:integration": "jest --config=jest.config.js",
    "test:integration:watch": "jest --config=jest.config.js --watch",
    "test:integration:coverage": "jest --config=jest.config.js --coverage",
    "test": "jest --config=jest.unit.config.js --verbose=false --silent",
    "test:clean:integration": "jest --config=jest.config.js --verbose=false --silent",
    "test:all": "jest --config=jest.unit.config.js && jest --config=jest.config.js",
    "test:coverage:all": "jest --config=jest.unit.config.js --coverage && jest --config=jest.config.js --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "@types/express-session": "^1.18.2",
    "@types/uuid": "^10.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "express-session": "^1.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/axios": "^0.9.36",
    "@types/bcrypt": "^5.0.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.7",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "sqlite3": "^5.1.7",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
